{
  "name": "@steipete/claude-code-mcp",
  "version": "1.11.0",
  "description": "Simple MCP server for Claude Code one-shot execution",
  "keywords": [
    "ai",
    "claude",
    "llm",
    "mcp",
    "model-context-protocol",
    "tools"
  ],
  "homepage": "https://github.com/steipete/claude-code-mcp#readme",
  "bugs": {
    "url": "https://github.com/steipete/claude-code-mcp/issues"
  },
  "license": "MIT",
  "author": "Peter Steinberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steipete/claude-code-mcp.git"
  },
  "bin": {
    "claude-code-mcp": "dist/server.js"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsgo",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "pnpm run build && vitest run",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:e2e": "pnpm run build && vitest run --config vitest.config.e2e.ts",
    "test:coverage": "pnpm run build && vitest --coverage --config vitest.config.unit.ts",
    "test:watch": "vitest --watch",
    "typecheck": "tsgo --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run format:check && oxlint --deny-warnings --allow eslint/no-unused-vars src test tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.5",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "which": "^6.0.1"
  },
  "packageManager": "pnpm@10.33.2"
}
